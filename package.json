{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:uc1": "vitest run --coverage --coverage.include=\"src/modules/uc1-warning/**\"",
    "test:uc2": "vitest run --coverage --coverage.include=\"src/modules/uc2-report/**\"",
    "test:uc3": "vitest run --coverage --coverage.include=\"src/modules/uc3-resources/**\"",
    "test:uc4": "vitest run --coverage --coverage.include=\"src/modules/uc4-analysis/**\"",
    "test:integration": "vitest run tests/integration",
    "test:uc4:db": "vitest run tests/integration/uc4-db-full.test.ts",
    "test:uc4:db:script": "tsx scripts/uc4-full-db-test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@serwist/next": "^9.5.13",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "serwist": "^9.5.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
