model AnalysisReport {
  id           String   @id @default(uuid()) @db.Uuid
  filters      Json
  sourceCutoff DateTime @map("source_cutoff") @db.Timestamptz
  generatedAt  DateTime @map("generated_at") @db.Timestamptz
  metrics      Json
  warningFlag  Boolean  @default(false) @map("warning_flag")
  generatedBy  String   @map("generated_by") @db.Uuid

  // Write-once snapshot: no updatedAt, no delete — enforced by design
  officer Officer         @relation(fields: [generatedBy], references: [id])
  shares  ReportShare[]

  @@index([generatedAt])
  @@map("analysis_report")
}

model ReportShare {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  status         ShareStatus
  attemptedAt    DateTime @map("attempted_at") @db.Timestamptz
  actorId        String   @map("actor_id") @db.Uuid
  failureReason  String?  @map("failure_reason")

  // Retries append new rows — one per recipient per attempt
  report       AnalysisReport @relation(fields: [reportId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  actor        Officer        @relation(fields: [actorId], references: [id])

  @@index([reportId])
  @@map("report_share")
}

enum ShareStatus {
  SENT
  FAILED
}
